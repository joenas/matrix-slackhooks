# Example config for matrix-slackhooks.
# Copy to config.yaml and edit. Every value can also be set via an
# SLACKHOOKS_* environment variable (see README).

# The Matrix homeserver.
homeserver_url: http://localhost:8008
server_name: localhost

# Appservice tokens. They must match the registration file given to the
# homeserver. Run `slackhooks generate-registration` to create both.
as_token: ""
hs_token: ""

# Address the appservice listens on (Matrix transaction calls from the
# homeserver). A unix socket path is also accepted.
as_address: "0.0.0.0:29329"

# URL the homeserver uses to reach the appservice (written into the
# generated registration file). Defaults to the listen address on localhost.
appservice_url: "http://localhost:29329"

# Optional separate address to serve the public webhook endpoints on. If
# empty, webhooks are served on the appservice address above.
webhook_address: ""

# Public base URL used when printing webhook URLs (add-hook output).
public_base_url: "https://hooks.example.com"

# SQLite database path.
db: slackhooks.db

# The appservice bot user.
bot_localpart: slackhooks
bot_displayname: Slack Hook

# Prefix for the puppet users created per webhook source.
user_prefix: _slackhook_

# Extra rooms the bot may join, besides every room that has a webhook. Each
# entry is a room ID (!localpart:server) or an alias (#localpart:server).
# Rooms with a webhook are always allowed automatically, so to let the bot
# into a room just add a hook for it and invite the bot; you only need this
# list for rooms without a hook. Env override: SLACKHOOKS_ALLOWED_ROOMS
# (comma-separated).
# allowed_rooms:
#   - "#team:example.com"
#   - "!abcdef:example.com"

# Matrix user IDs or patterns that may run bot commands in any room the bot
# is in, and may invite the bot to any room. A "*" in place of the localpart
# (e.g. "@*:example.com") matches every user on that server. Env override:
# SLACKHOOKS_ADMINS (comma-separated).
# admins:
#   - "@alice:example.com"
#   - "@*:example.com"

# Minimum power level required in the room for non-admins to run bot commands.
# Set above 100 (e.g. 101) to make commands admins-only.
# Env override: SLACKHOOKS_COMMAND_POWER_LEVEL
command_power_level: 50

# Prefix for bot commands in chat. Env override: SLACKHOOKS_COMMAND_PREFIX
command_prefix: "!hook"

# Event type used for messages: m.text or m.notice.
default_msgtype: m.text
